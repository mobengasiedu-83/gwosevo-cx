{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM"],
        "types": ["vite/client"],
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue"]
}
